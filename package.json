{
  "name": "pokernext",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "prettier": "gts/.prettierrc.json",
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm lint:boundaries && pnpm test",
    "fix": "gts fix",
    "lint": "gts lint",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs apps packages tooling",
    "prepare": "husky",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "dependency-cruiser": "^18.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-check-file": "^3.3.2",
    "gts": "^7.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
